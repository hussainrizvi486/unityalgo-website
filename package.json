    "exceljs": "^4.4.0",
    "flag-icons": "^7.6.0",
    "input-otp": "^1.5.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.553.0",
    "motion": "^11.15.0",
    "next": "16.2.11",
    "nodemailer": "^7.0.10",
    "pg": "^8.22.0",
    "quill": "^2.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
