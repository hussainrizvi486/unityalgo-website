{
  "name": "unityalgo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "predev": "node scripts/sync-tokens.mjs",
    "prebuild": "node scripts/sync-tokens.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 2424",
    "lint": "eslint",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:all": "eslint && tsc --noEmit && node scripts/check-tokens.mjs",
    "admin:create": "tsx scripts/manage-admin.ts create",
    "admin:set-password": "tsx scripts/manage-admin.ts set-password",
    "admin:list": "tsx scripts/manage-admin.ts list",
    "admin:delete": "tsx scripts/manage-admin.ts delete",
    "seed:plans": "tsx scripts/seed-plans.ts",
    "seed:currencies": "tsx scripts/seed-currencies.ts",
    "test:e2e": "tsx scripts/e2e-test.ts",
    "test:security": "tsx scripts/security-test.ts",
    "dev:all": "bash scripts/dev.sh",
    "test:paddle": "node --conditions=react-server --import tsx scripts/test-paddle-billing.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "tsx scripts/db-baseline.mts",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "test:db": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-db.mts",
    "test:dbcheck": "tsx scripts/test-db-check.mts",
    "test:emails": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-email-templates.mts",
    "test:ratelimits": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-rate-limits.mts",
    "test:onboarding": "node --import tsx scripts/test-onboarding-defaults.mts",
    "test:modules": "node --import tsx scripts/test-app-modules.mts",
    "test:spreadsheet": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-spreadsheet.mts",
    "test:billing": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-app-billing.mts",
    "billing:worker": "NODE_OPTIONS=--conditions=react-server tsx scripts/paddle-worker.mts",
    "test:paddle:billing": "node --conditions=react-server --import tsx scripts/test-paddle-billing.mts",
    "test:paddle:sandbox:credits": "node --import tsx scripts/test-paddle-sandbox-credits.mts",
    "billing:webhook": "node --conditions=react-server --import tsx scripts/configure-paddle-webhook.mts",
    "test:paddle:site:sandbox": "node --conditions=react-server --import tsx scripts/test-site-billing-sandbox.mts"
