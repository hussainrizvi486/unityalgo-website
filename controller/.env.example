# =============================================================================
# UnityCommerce Infrastructure Controller -- environment template
# Copy to .env and fill in real values:  cp .env.example .env
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Flask application -------------------------------------------------------
APP_NAME=unitycommerce-controller
APP_ENV=development           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
SECRET_KEY=change-me
SESSION_LIFETIME_SECONDS=43200

# --- Tenant database backups --------------------------------------------------
BACKUP_DIR=./backups
PG_BIN_DIR=              # leave empty to auto-detect pg_dump/pg_restore/psql

# --- PostgreSQL (control-plane state store) ----------------------------------
# DATABASE_URL, if set, overrides the POSTGRES_* parts below.
# Must be a sync driver -- the controller runs SQLAlchemy 2.0 + psycopg2.
POSTGRES_HOST=localhost
POSTGRES_PORT=5450
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
DATABASE_URL=
# Applies to admin connections and pg_dump/pg_restore (the SQLAlchemy engine
# takes its own sslmode from DATABASE_URL). 'require' for managed Postgres.
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=10
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_ALWAYS_EAGER=false

# --- Credential encryption -----------------------------------------------
# Required to register any database connection or cluster (Databases page) --
# their passwords are Fernet-encrypted at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Webhooks from the main platform (unityalgo.com) -------------------------
WEBHOOK_SECRET=change-me
WEBHOOK_SIGNATURE_HEADER=X-Signature

# --- Tenant provisioning defaults --------------------------------------------
BASE_DOMAIN=unityalgo.com
TENANT_IMAGE=ghcr.io/unityalgo/unitycommerce-template:latest
TENANT_CONTAINER_PORT=3000
TENANT_MEMORY_LIMIT_MB=256
TENANT_CPU_LIMIT_CORES=0.50
TENANT_DB_PREFIX=tenant_db_
TENANT_USER_PREFIX=user_

# Address of the controller's Postgres AS SEEN FROM A WORKER NODE.
# REQUIRED before provisioning: must not be localhost/127.0.0.1, or containers
# on remote nodes will try to reach Postgres on themselves.
TENANT_DB_HOST=
TENANT_DB_PORT=
# require for managed Postgres (DigitalOcean/RDS); disable for plain local PG.
TENANT_DB_SSLMODE=require

# --- Tenant schema migrations -------------------------------------------------
# Migrations run from the Dockerfile's `migrate` stage -- a different image from
# the runtime (`runner`) stage, which ships no scripts/ or drizzle/.
# Default migrate tag = runtime tag + suffix (repo:1.0.0 -> repo:1.0.0-migrate).
TENANT_MIGRATE_IMAGE=
TENANT_MIGRATE_IMAGE_SUFFIX=-migrate
TENANT_MIGRATE_COMMAND=node scripts/migrate.mjs
TENANT_MIGRATE_PROBE=scripts/migrate.mjs
TENANT_MIGRATE_TIMEOUT=600
TENANT_MIGRATE_ON_PROVISION=true

# Resolvers passed to every tenant container/job via `docker run --dns`.
TENANT_DNS_SERVERS=1.1.1.1,8.8.8.8
# Passed to every tenant process as MEDIA_DRIVER.
TENANT_MEDIA_DRIVER=local

# --- Host port allocation for tenant containers ------------------------------
# Below Linux's ephemeral range (32768-60999) so it can never collide with an
# outbound socket on the node.
TENANT_PORT_RANGE_START=20000
TENANT_PORT_RANGE_END=29999
PORT_REUSE_COOLDOWN_SECONDS=300
NODE_MEMORY_RESERVE_MB=1024

# --- Worker VPS nodes (SSH / Docker) -----------------------------------------
# Defaults for nodes registered without their own credentials.
SSH_USER=ubuntu
SSH_PORT=22
SSH_PASSWORD=                   # leave empty to use key auth only
SSH_KEY_PATH=~/.ssh/id_controller_dev
SSH_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30
SSH_HOST_KEY_POLICY=auto        # auto = trust unknown host keys (dev) | reject
DOCKER_SOCKET=unix://var/run/docker.sock

# --- Traefik edge proxy ------------------------------------------------------
TRAEFIK_NETWORK=web_network
TRAEFIK_CERT_RESOLVER=myresolver
TRAEFIK_ENTRYPOINT=websecure

# --- Caddy edge proxy ---------------------------------------------------------
# Defaults to BASE_DOMAIN -- only set this if you want platform subdomains on
# a different suffix than BASE_DOMAIN.
PLATFORM_DOMAIN=
PROXY_ADMIN_PORT_DEFAULT=2019
PROXY_ENABLE_TLS=false
PROXY_HEALTH_CHECK_TIMEOUT_SECONDS=5

# --- Periodic health-check sweep (Celery Beat) --------------------------------
HEALTH_CHECK_INTERVAL_SECONDS=300
HEALTH_CHECK_PROBE_TIMEOUT_SECONDS=5

# --- Scheduled tenant backups (Celery Beat) -----------------------------------
# Off by default: a fleet-wide pg_dump sweep is real load on the controller host
# and on every database cluster, so it is opted into rather than started by an
# upgrade. Requires the `celery beat` process (python main.py beat).
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_INTERVAL_SECONDS=86400
# Scheduled dumps kept per tenant. Only reason="scheduled" rows are ever
# pruned -- a backup taken before a migration, resize or delete is the record
# of that operation and is never removed by a timer.
BACKUP_RETENTION_COUNT=7

# --- WebSocket service: SSH terminal + live log/metric streams ----------------
# One process serves /ws/terminal/<server_id>, /ws/stream/logs/<deployment_id>
# and /ws/stream/stats/<deployment_id>. Loopback-only: reach it through the
# nginx location blocks, never bind it to a public interface.
WS_TERMINAL_HOST=127.0.0.1
WS_TERMINAL_PORT=8765
WS_TERMINAL_IDLE_TIMEOUT_SECONDS=900
# Idle, not total: a stream producing output steadily stays open past this.
WS_STREAM_IDLE_TIMEOUT_SECONDS=1800

# --- Database connection query console ---------------------------------------
QUERY_CONSOLE_TIMEOUT_SECONDS=30
QUERY_CONSOLE_MAX_ROWS=500

# --- API behaviour -----------------------------------------------------------
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Customer Frappe site hosting (controller-only)
# Configure a dedicated base domain pointing at the Caddy proxy. Leave blank to disable creation.
FRAPPE_SITE_DOMAIN=cloud.unityalgo.com
# Build a custom image for Lending/FBR; the stock image contains frappe and erpnext only.
FRAPPE_IMAGE=frappe/erpnext:v16.50.0
FRAPPE_AVAILABLE_APPS=erpnext
FRAPPE_PORT_START=30000
FRAPPE_PORT_END=31999
# Next.js internal address for provisioning completion notifications.
PLATFORM_INTERNAL_URL=http://127.0.0.1:3000

# Used when a plan does not set its own vCPU / RAM / storage.
# FRAPPE_DEFAULT_VCPU=2
# FRAPPE_DEFAULT_RAM_MB=4096
# FRAPPE_DEFAULT_STORAGE_GB=10
# Refuse to place a site on a worker too small for its plan. Set false only on a small development VM.
# FRAPPE_ENFORCE_CAPACITY=true
# Reserved vCPUs may exceed physical cores by this factor.
# FRAPPE_CPU_OVERCOMMIT=2
# How often seats and storage are checked against each plan (needs `python main.py beat`).
# SITE_AUDIT_INTERVAL_SECONDS=900

# --- App Store: GitHub applications ---
# Optional. Raises GitHub's API limit from 60 to 5000 requests an hour. Public repositories only.
# GITHUB_TOKEN=
# Frappe majors an app must support to be installed. Defaults to the major of FRAPPE_IMAGE (e.g. 16).
# FRAPPE_COMPATIBLE_MAJORS=15
# How often every running site is asked which app versions it runs (seconds).
# APP_SCAN_INTERVAL_SECONDS=21600

# What "Open site" links point at: auto (default), direct or domain.
#   direct = http://<worker address>:<port>, for local development where the base domain does not resolve
#   domain = https://<slug>.<FRAPPE_SITE_DOMAIN>; auto uses direct everywhere except APP_ENV=production
# FRAPPE_SITE_LINKS=auto
