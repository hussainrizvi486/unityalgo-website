# Server-only Paddle API key. Never expose this with a NEXT_PUBLIC_ prefix.
PADDLE_API_KEY=

# Signing secret for the notification destination pointed at
# POST /api/paddle/webhook (Paddle > Notifications > your destination).
# Required: that webhook is the only thing that grants a paid subscription, and
# it rejects every request when this is unset rather than trusting unverified
# events.
PADDLE_WEBHOOK_SECRET=

# Public Paddle.js configuration from Paddle > Developer tools > Authentication.
# The client token has to carry the NEXT_PUBLIC_ prefix — without it Next.js
# never sends it to the browser and the checkout overlay cannot open.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Per-plan Paddle price IDs are NOT environment variables. They live on the
# plan row (Plan.paddlePriceId) and are edited in Admin > Plans, because plans
# are created and renamed at runtime and env keys named after them go stale.

# Encrypts credentials the app has to be able to read back — currently mail
# account passwords (lib/secret-box.ts). Generate with `openssl rand -base64 32`.
# Keep it out of the database: that separation is what makes a leaked dump
# useless. Rotating it makes existing stored passwords undecryptable, so
# re-enter them in Admin > Email accounts afterwards.
CREDENTIAL_ENCRYPTION_KEY=

# Fallback SMTP, used when no email account row matches the mail being sent.
# Mailboxes are managed in Admin > Email accounts; these stay as the default
# so an install that never opens that screen still sends.
# Server-only — never hardcode these in application code.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional: defaults to SMTP_USER if unset.
SMTP_FROM=

# WhatsApp number for the "Chat on WhatsApp" button on the customer support
# page (app/dashboard/support/page.tsx). Digits only, with country code, no
# "+" or spaces (wa.me format, e.g. 15551234567). The button is hidden if unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Core (required) ---------------------------------------------------------
# Postgres connection shared by Prisma AND the Python controller — one database
# for the whole platform. See controller/README.md for which tool owns which
# tables.
DATABASE_URL=postgresql://postgres:password@localhost:5440/unityalgo
# Signs admin/customer session JWTs (lib/auth.ts, lib/customer-auth.ts) and the
# short-lived terminal grants the controller verifies. Must match
# controller/.env's SESSION_SECRET.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Controller (Python infrastructure API) ----------------------------------
# Base URL of the Flask service in controller/ (lib/controller-client.ts).
# Keep it on localhost or a private network — it is not safe to expose.
CONTROLLER_API_URL=http://127.0.0.1:8000
# Shared secret presented on every /api/v1/* call. Must match
# controller/.env's CONTROLLER_INTERNAL_API_KEY. Server-only: never prefix
# this with NEXT_PUBLIC_.
CONTROLLER_INTERNAL_API_KEY=
# WebSocket endpoint for the browser SSH terminal. Public by necessity (the
# browser connects to it directly), but every connection still requires a
# 60-second, single-server grant minted server-side.
NEXT_PUBLIC_CONTROLLER_WS_URL=ws://127.0.0.1:8765

# Public base URL used in customer emails (site status links).
PLATFORM_PUBLIC_URL=https://www.unityalgo.com

# Paid apps. "test" records purchases without charging Paddle (refused when NODE_ENV=production); leave unset to charge for real.
# APP_BILLING_MODE=test

# Database check when the site starts. warn (default) logs the result and a diagnosis; strict also stops the server when
# the database is unreachable; off skips the check. Optional: PLATFORM_NAME is the name used in emails (default UnityAlgo).
# DB_STARTUP_CHECK=warn
# PLATFORM_NAME=UnityAlgo
