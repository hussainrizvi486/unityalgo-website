# Server-only Paddle API key. Never expose this with a NEXT_PUBLIC_ prefix.
PADDLE_API_KEY=

# Public Paddle.js configuration from Paddle > Developer tools > Authentication.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_STARTER_PRICE_ID=
NEXT_PUBLIC_PADDLE_GROWTH_PRICE_ID=
NEXT_PUBLIC_PADDLE_PROFESSIONAL_PRICE_ID=
NEXT_PUBLIC_PADDLE_ENTERPRISE_PRICE_ID=
