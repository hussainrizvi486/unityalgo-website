generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  role            Role      @default(ADMIN)
  name            String?
  firstName       String?
  lastName        String?
  username        String?   @unique
  phone           String?
  company         String?
  companyEmail    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Merged in from the controller's retired `customers` table, which used to
  // be a second, parallel record of the same people. See
  // scripts/migrate-controller-customers.ts.
  jobTitle          String?
  alternatePhone    String?
  website           String?
  taxId             String?
  industry          String?
  companySize       String?
  preferredCurrency String?
  notes             String?

  subscriptions  Subscription[]
  addresses      Address[]
  supportTickets SupportTicket[]
  comments       Comment[]
  billingRecords BillingRecord[]
  loginSessions  LoginSession[]
  notifications Notification[]

  @@index([role])
  leads Lead[]
}

enum BillingStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

/// Manual invoices, migrated from the controller's `billing_records` table.
/// `tenantId` is a soft reference into the Alembic-owned `tenants` table
/// rather than a Prisma relation — Prisma does not manage that table, so the
/// FK is declared in the Alembic migration instead.
model BillingRecord {
  id               String        @id @default(cuid())
  userId           String
  subscriptionId   String?
  // The controller's `tenants` table uses UUID primary keys, so this column
  // must be a real uuid for the cross-tool foreign key to be accepted.
  tenantId         String?       @db.Uuid
  invoiceNumber    String        @unique
  description      String
  amount           Float
  currency         String        @default("USD")
  status           BillingStatus @default(DRAFT)
  periodStart      DateTime?
  periodEnd        DateTime?
  issuedAt         DateTime?
  dueDate          DateTime?
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?
  /// Set when Paddle reports an adjustment (refund or credit) against the
  /// transaction this invoice was raised for.
  refundedAt       DateTime?
  refundedAmount   Float?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  // Postgres does not index a foreign key for you, and an unindexed one is
  // scanned in full every time the parent row is deleted or its key updated.
  @@index([subscriptionId])
  @@index([tenantId])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String       @id @default(cuid())
  userId      String
  subject     String
  description String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// Generic comment thread — not a dedicated "TicketComment" table. Any record
// in any table can have a comment thread by writing its own type tag into
// entityType (e.g. "SUPPORT_TICKET") and its id into entityId; entityId is
// deliberately not a foreign key since it can point at rows in different
// tables, so referential cleanup for a deleted parent is the caller's job.
model Comment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  // Cascades on user deletion walk this key; without an index that is a full
  // scan of every comment ever written.
  @@index([authorId])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postcode     String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum VerificationPurpose {
  REGISTRATION
  PASSWORD_RESET
}

model EmailVerification {
  id         String              @id @default(cuid())
  email      String
  otp        String
  purpose    VerificationPurpose @default(REGISTRATION)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([email, purpose])
}

/// Where a lead came from. Only the contact form exists today; the enum is
/// here so a second channel does not require a migration on the Lead table
/// itself.
enum LeadSource {
  CONTACT_FORM
  IMPORT
  MANUAL
}

/// How far along a lead is. NEW is what the public form creates; everything
/// else is set by an admin.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

/// A person who asked to be contacted.
///
/// Separate from User: a lead has not registered and may never do so, and the
/// same person can appear more than once. `userId` is filled in only if the
/// lead later becomes an account, which is why it is optional and not unique
/// on its own.
model Lead {
  id        String @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String
  company   String?
  message   String

  source LeadSource @default(CONTACT_FORM)
  status LeadStatus @default(NEW)
  /// Internal follow-up notes. Never shown to the person who submitted.
  notes  String?

  /// Set if this lead later registered an account.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([userId])
  @@map("leads")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_list")
}

// The two products sold on the site — plans and add-ons each belong to one
// of these, so the purchase-plans UI can group/filter by product.
enum PriceUnit {
  PER_USER_MONTHLY
  FLAT_MONTHLY
}

enum AddOnPricingType {
  FLAT_MONTHLY
  ONE_TIME
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  /// Paddle could not collect a renewal. Access decisions should treat this as
  /// unpaid; without it a lapsed subscription is indistinguishable from a
  /// current one.
  PAST_DUE
  CANCELED
}

/// The products UnityAlgo sells. Was a Prisma enum; promoted to a table so a
/// new product can be added — with its own label, tagline and marketing URL —
/// without a schema migration and a redeploy.
model Product {
  /// Stable snake_case key, e.g. "algo_suite". Referenced by every plan,
  /// add-on and subscription, so it is chosen once and never edited.
  id            String   @id
  /// Display name shown across the site, e.g. "AlgoSuite".
  label         String
  /// URL segment under /products, e.g. "algosuite".
  slug          String   @unique
  tagline       String?
  isActive      Boolean  @default(true)
  /// Whether this product is advertised in the landing page's plans section.
  /// Separate from `isActive`: a product can be fully sellable to customers
  /// who reach its page while not yet being promoted on the home page.
  showOnLanding Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plans         Plan[]
  addOns        AddOn[]
  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

/// A currency prices can be quoted in.
///
/// A table rather than an enum so an admin can add one without a migration,
/// and so the symbol and grouping rules live next to the code that formats
/// with them.
model Currency {
  id     String @id @default(cuid())
  /// ISO 4217 where one exists — USD, PKR. Uppercased on save.
  code   String @unique
  /// Display name, e.g. "US Dollar".
  name   String
  symbol String

  /// Grouping and decimal pattern, e.g. "#,###.##" (thousands) or
  /// "#,##,###.##" (the South Asian lakh/crore grouping). Stored as a pattern
  /// rather than a locale name so an admin can express a format Intl has no
  /// locale for.
  numberFormat String @default("#,###.##")

  /// Enabled/Disabled in the admin. Named for the convention the rest of the
  /// schema already uses.
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans Plan[]

  @@index([isActive, sortOrder])
}

model Plan {
  id                    String    @id @default(cuid())
  productId             String
  name                  String
  slug                  String
  tagline               String?
  priceUnit             PriceUnit @default(FLAT_MONTHLY)
  // Null price means "custom quote" — no separate flag needed, the price
  // field itself carries that meaning.
  priceAmount           Float?
  transactionFeePercent Float?
  // Null means unlimited seats.
  userLimit             Int?
  features              String[]  @default([])
  /// The Paddle price this plan is sold through. Null means it cannot be
  /// bought online — a custom-quote tier, or one not yet wired up in Paddle.
  /// Checkout refuses to open without it rather than guessing.
  paddlePriceId         String?   @unique
  /// Currency this plan is priced in. Optional so existing rows stay valid;
  /// display falls back to USD, which is what Paddle already charges in.
  currencyId            String?
  isActive              Boolean   @default(true)
  sortOrder             Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  product       Product        @relation(fields: [productId], references: [id])
  currency      Currency?      @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]

  @@unique([productId, slug])
  @@index([productId, isActive])
  // Unindexed foreign keys are scanned in full when the parent is deleted.
  @@index([currencyId])
}

model AddOn {
  id          String           @id @default(cuid())
  productId   String
  name        String
  slug        String
  description String?
  pricingType AddOnPricingType @default(FLAT_MONTHLY)
  // Null price means "custom quote" (e.g. project-fee work), same
  // convention as Plan.priceAmount.
  priceAmount Float?
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  product            Product             @relation(fields: [productId], references: [id])
  subscriptionAddOns SubscriptionAddOn[]

  @@unique([productId, slug])
  @@index([productId, isActive])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  // Denormalized from plan.productId — lets a customer hold at most one
  // subscription per product (one AlgoSuite plan + one UnityCommerce plan at
  // the same time) without a join, enforced by the unique index below.
  productId            String
  status               SubscriptionStatus @default(ACTIVE)
  /// Set by the webhook once Paddle confirms payment. Unique so a Paddle
  /// subscription can never be attached to two customers.
  paddleSubscriptionId String?            @unique
  paddleCustomerId     String?
  storeName            String?
  startedAt            DateTime           @default(now())
  currentPeriodEnd     DateTime?
  /// When Paddle reported the cancellation. Access normally runs to
  /// `currentPeriodEnd` after this — cancelling is not the same as losing
  /// the rest of a period that has been paid for.
  canceledAt           DateTime?
  /// Set when the customer has cancelled but the current period is still
  /// running, so the UI can say "ends on ..." rather than "cancelled".
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           Plan                @relation(fields: [planId], references: [id])
  product        Product             @relation(fields: [productId], references: [id])
  addOns         SubscriptionAddOn[]
  billingRecords BillingRecord[]

  @@unique([userId, productId])
  // The composite above is userId-leading, so it cannot serve a lookup by
  // product or plan alone — both of which the admin does when checking
  // whether a plan is still in use.
  @@index([planId])
  @@index([productId])
}

/// Every Paddle webhook this app has accepted, keyed by Paddle's own event id.
///
/// Paddle retries a delivery until it gets a 2xx, so the same event arrives
/// more than once as a matter of course. Inserting the id first makes handling
/// idempotent: a replay collides on the primary key and is dropped before it
/// can bill or provision anything twice. The payload is kept because a payment
/// dispute is argued from what the provider actually sent.
/// Where a webhook delivery is in its lifecycle.
///
/// The row is written before any work happens, so a delivery that crashes
/// mid-handler is still on record. Only PROCESSED stops a Paddle retry from
/// being handled again — a FAILED or PENDING row is fair game, which is what
/// makes a transient database error recoverable instead of a silently lost
/// payment.
enum PaddleEventStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

model PaddleEvent {
  id          String            @id
  eventType   String
  payload     Json
  status      PaddleEventStatus @default(PENDING)
  /// How many times Paddle has delivered this event id. A number climbing
  /// past a few means a handler is failing repeatedly on one payment.
  attempts    Int               @default(0)
  /// Why the last attempt failed, kept so a stuck payment can be diagnosed
  /// without digging through application logs.
  error       String?
  processedAt DateTime?
  receivedAt  DateTime          @default(now())

  @@index([eventType, receivedAt])
  /// Drives the "deliveries that never succeeded" view.
  @@index([status, receivedAt])
}

model SubscriptionAddOn {
  id             String   @id @default(cuid())
  subscriptionId String
  addOnId        String
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addOn        AddOn        @relation(fields: [addOnId], references: [id])

  @@unique([subscriptionId, addOnId])
  // Same shape: the unique index starts with subscriptionId, so removing an
  // add-on from the catalogue scanned this table in full to check the key.
  @@index([addOnId])
}

/// What a mail account is used for. Routing is by purpose, falling back to
/// the default account, so adding a purpose never leaves mail unsendable.
enum EmailPurpose {
  /// Verification codes, password resets — anything the app sends automatically.
  TRANSACTIONAL
  /// Support ticket correspondence.
  SUPPORT
  /// Invoices and payment notices.
  BILLING
  /// Announcements and campaigns.
  MARKETING
}

/// A mailbox the platform sends from, and optionally receives into.
///
/// SMTP credentials used to live only in environment variables, which meant one
/// mailbox for the whole platform and a redeploy to change it. They are rows
/// now so support, billing and transactional mail can come from different
/// addresses, editable by an admin.
///
/// Passwords are stored as AES-256-GCM ciphertext (lib/secret-box.ts), never in
/// the clear, and are never sent to a browser. The env-based configuration
/// still works and is used when no account matches.
model EmailAccount {
  id       String       @id @default(cuid())
  /// Human label shown in the admin list, e.g. "Support".
  label    String
  /// The address mail is sent from, and received for.
  address  String       @unique
  /// Display name on outgoing mail; falls back to `label`.
  fromName String?
  purpose  EmailPurpose @default(TRANSACTIONAL)

  // Outgoing. Required — an account that cannot send is not useful.
  smtpHost     String
  smtpPort     Int     @default(587)
  /// True for implicit TLS (465). False starts plaintext and upgrades via
  /// STARTTLS, which is what 587 and 25 expect.
  smtpSecure   Boolean @default(false)
  smtpUsername String
  smtpPassword String  @map("smtpPasswordCiphertext")

  // Incoming. Optional, and a different protocol entirely — SMTP cannot
  // receive mail, so a mailbox that is only configured for sending simply
  // leaves these null.
  imapHost     String?
  imapPort     Int?    @default(993)
  imapSecure   Boolean @default(true)
  imapUsername String?
  imapPassword String? @map("imapPasswordCiphertext")

  /// At most one account is the default, enforced by a partial unique index.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  /// Result of the last connection test, so the list can show what works
  /// without re-dialling every server on render.
  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  lastTestError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purpose, isActive])
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  content         String
  coverImage      String
  tags            String[]  @default([])
  published       Boolean   @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  bgColor         String?
  textColor       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt])
}

/// Server-managed application catalogue. App packages must be present in the Frappe image.
model AppCatalog {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String
  category       String
  frappeAppName  String?
  isInstallable  Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LoginSession {
  id         String   @id @default(uuid())
  userId     String
  userAgent  String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  eventKey  String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
}
